# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.

# Password for the SQL Server 'sa' account used by docker-compose.
# Must meet SQL Server complexity rules (>=8 chars, upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=

# --- LMS.API runtime configuration ---
# ASP.NET Core reads these environment variables and they override appsettings.json.
# The "__" (double underscore) maps to nested JSON sections.

# Database connection string used by the API.
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=LmsDb;User Id=SA;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True

# JWT signing key. Use a long random value (>= 64 chars). Generate one with:
#   openssl rand -base64 64
JwtSettings__SecretKey=
